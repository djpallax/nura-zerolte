			#address-cells = <0x01>;
			#size-cells = <0x00>;
			pinctrl-names = "default";
			pinctrl-0 = <0x0f>;
			clocks = <0x0c 0x04>;
			clock-names = "hsi2c";
			status = "okay";

			max77843@66 {
				maxim,rsense-micro-ohms = <0x2710>;
				samsung,zerolte-power-readonly = <0x01>;
				samsung,zerolte-staged-irqs = <0x01>;
				pinctrl-0 = <0x25>;
				pinctrl-names = "default";
				interrupts = <0x04 0x02>;
				interrupt-parent = <0x24>;
				reg = <0x66>;
				compatible = "maxim,max77843";

				fuelgauge {
					io-channel-names = "battery-temp\0charger-temp";
					io-channels = <0x7420 0x01 0x7420 0x03>;
					compatible = "maxim,max77843-fuelgauge";
				};

				extcon {
					compatible = "maxim,max77843-muic";
				};
			};
		};

		i2c@14e60000 {
			compatible = "samsung,exynos7-hsi2c";
			reg = <0x14e60000 0x1000>;
			interrupts = <0x00 0x1cb 0x04>;
			#address-cells = <0x01>;
			#size-cells = <0x00>;
