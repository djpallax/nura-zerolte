/dts-v1/;

/ {
	compatible = "samsung,exynos7420-zerolte\0samsung,exynos7420\0samsung,exynos7";
	interrupt-parent = <0x01>;
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	model = "Samsung Galaxy S6 Edge SM-G925I (zerolte) - minimal bringup";

	gpio-keys {
		label = "Galaxy S6 physical keys";
		compatible = "gpio-keys";

		volume-down {
			debounce-interval = <0x14>;
			gpios = <0x7751 0x03 0x01>;
			linux,code = <0x72>;
			label = "volume-down";
		};

		volume-up {
			debounce-interval = <0x14>;
			gpios = <0x7751 0x02 0x01>;
			linux,code = <0x73>;
			label = "volume-up";
		};

		home {
			debounce-interval = <0x14>;
			gpios = <0x7751 0x05 0x01>;
			linux,code = <0xac>;
			label = "home";
		};

		power {
			debounce-interval = <0x14>;
			gpios = <0x2b 0x02 0x01>;
			linux,code = <0x74>;
			label = "power";
		};
	};

	opp-table-atlas {
		phandle = <0xd019>;
		opp-shared;
		compatible = "operating-points-v2";

		opp-400000000 {
			clock-latency-ns = <0xf4240>;
			opp-microvolt = <0xf4240>;
			opp-hz = <0x00 0x17d78400>;
		};

		opp-200000000 {
			clock-latency-ns = <0xf4240>;
			opp-microvolt = <0xf4240>;
			opp-hz = <0x00 0xbebc200>;
		};

		opp-1000000000 {
			clock-latency-ns = <0xf4240>;
			opp-microvolt = <0x100590>;
			opp-hz = <0x00 0x3b9aca00>;
		};

		opp-800000000 {
			clock-latency-ns = <0xf4240>;
			opp-microvolt = <0xfa3e8>;
			opp-hz = <0x00 0x2faf0800>;
		};

		opp-500000000 {
			clock-latency-ns = <0xf4240>;
			opp-microvolt = <0xf4240>;
			opp-hz = <0x00 0x1dcd6500>;
		};
	};

	opp-table-apollo {
		phandle = <0xd016>;
		opp-shared;
		compatible = "operating-points-v2";

		opp-400000000 {
			clock-latency-ns = <0xf4240>;
			opp-microvolt = <0xf4240>;
			opp-hz = <0x00 0x17d78400>;
		};

		opp-200000000 {
			clock-latency-ns = <0xf4240>;
			opp-microvolt = <0xf4240>;
			opp-hz = <0x00 0xbebc200>;
		};

		opp-1500000000 {
			clock-latency-ns = <0xf4240>;
			opp-microvolt = <0x100590>;
			opp-hz = <0x00 0x59682f00>;
		};

		opp-1000000000 {
			clock-latency-ns = <0xf4240>;
			opp-microvolt = <0x100590>;
			opp-hz = <0x00 0x3b9aca00>;
		};

		opp-500000000 {
			clock-latency-ns = <0xf4240>;
			opp-microvolt = <0xf4240>;
			opp-hz = <0x00 0x1dcd6500>;
		};
	};

	aliases {
		pinctrl0 = "/soc@0/pinctrl@10580000";
		pinctrl1 = "/soc@0/pinctrl@13470000";
		pinctrl2 = "/soc@0/pinctrl@14cd0000";
		pinctrl3 = "/soc@0/pinctrl@14ce0000";
		pinctrl4 = "/soc@0/pinctrl@14c90000";
		pinctrl5 = "/soc@0/pinctrl@14ca0000";
		pinctrl6 = "/soc@0/pinctrl@10e60000";
		pinctrl7 = "/soc@0/pinctrl@15690000";
		pinctrl8 = "/soc@0/pinctrl@14870000";
		serial0 = "/soc@0/serial@14c20000";
		pinctrl9 = "/soc@0/pinctrl@114b0000";
		serial4 = "/soc@0/serial@11460000";
	};

	arm-pmu {
		compatible = "arm,cortex-a57-pmu";
		interrupts = <0x00 0x38 0x04 0x00 0x39 0x04 0x00 0x3a 0x04 0x00 0x3b 0x04>;
		interrupt-affinity = <0x02 0x03 0x04 0x05>;
	};

	clock {
		compatible = "fixed-clock";
		clock-output-names = "fin_pll";
		#clock-cells = <0x00>;
		clock-frequency = <0x16e3600>;
		phandle = <0x08>;
	};

	cpus {
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		cpu@0 {
			#cooling-cells = <0x02>;
			operating-points-v2 = <0xd019>;
			cpu-supply = <0xd018>;
			clocks = <0xd017 0x04>;
			device_type = "cpu";
			compatible = "arm,cortex-a57";
			reg = <0x00>;
			enable-method = "psci";
			i-cache-size = <0xc000>;
			i-cache-line-size = <0x40>;
			i-cache-sets = <0x100>;
			d-cache-size = <0x8000>;
			d-cache-line-size = <0x40>;
			d-cache-sets = <0x100>;
			next-level-cache = <0x06>;
			phandle = <0x02>;
		};

		cpu@1 {
			#cooling-cells = <0x02>;
			operating-points-v2 = <0xd019>;
			cpu-supply = <0xd018>;
			clocks = <0xd017 0x04>;
			device_type = "cpu";
			compatible = "arm,cortex-a57";
			reg = <0x01>;
			enable-method = "psci";
			i-cache-size = <0xc000>;
			i-cache-line-size = <0x40>;
			i-cache-sets = <0x100>;
			d-cache-size = <0x8000>;
			d-cache-line-size = <0x40>;
			d-cache-sets = <0x100>;
			next-level-cache = <0x06>;
			phandle = <0x03>;
		};

		cpu@2 {
			#cooling-cells = <0x02>;
			operating-points-v2 = <0xd019>;
			cpu-supply = <0xd018>;
			clocks = <0xd017 0x04>;
			device_type = "cpu";
			compatible = "arm,cortex-a57";
			reg = <0x02>;
			enable-method = "psci";
			i-cache-size = <0xc000>;
			i-cache-line-size = <0x40>;
			i-cache-sets = <0x100>;
			d-cache-size = <0x8000>;
			d-cache-line-size = <0x40>;
			d-cache-sets = <0x100>;
			next-level-cache = <0x06>;
			phandle = <0x04>;
		};

		cpu@3 {
			#cooling-cells = <0x02>;
			operating-points-v2 = <0xd019>;
			cpu-supply = <0xd018>;
			clocks = <0xd017 0x04>;
			device_type = "cpu";
			compatible = "arm,cortex-a57";
			reg = <0x03>;
			enable-method = "psci";
			i-cache-size = <0xc000>;
			i-cache-line-size = <0x40>;
			i-cache-sets = <0x100>;
			d-cache-size = <0x8000>;
			d-cache-line-size = <0x40>;
			d-cache-sets = <0x100>;
			next-level-cache = <0x06>;
			phandle = <0x05>;
		};

		l2-cache0 {
			compatible = "cache";
			cache-level = <0x02>;
			cache-unified;
			cache-size = <0x200000>;
			cache-line-size = <0x40>;
			cache-sets = <0x800>;
			phandle = <0x06>;
		};

		cpu@100 {
			#cooling-cells = <0x02>;
			operating-points-v2 = <0xd016>;
			cpu-supply = <0xd015>;
			clocks = <0xd014 0x04>;
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x100>;
			enable-method = "psci";
		};

		cpu@101 {
			#cooling-cells = <0x02>;
			operating-points-v2 = <0xd016>;
			cpu-supply = <0xd015>;
			clocks = <0xd014 0x04>;
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x101>;
			enable-method = "psci";
		};

		cpu@102 {
			#cooling-cells = <0x02>;
			operating-points-v2 = <0xd016>;
			cpu-supply = <0xd015>;
			clocks = <0xd014 0x04>;
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x102>;
			enable-method = "psci";
		};

		cpu@103 {
			#cooling-cells = <0x02>;
			operating-points-v2 = <0xd016>;
			cpu-supply = <0xd015>;
			clocks = <0xd014 0x04>;
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x103>;
			enable-method = "psci";
		};
	};

	psci {
		compatible = "arm,psci";
		method = "smc";
		cpu_off = <0x84000002>;
		cpu_on = <0xc4000003>;
	};

	soc@0 {
		compatible = "simple-bus";
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		ranges = <0x00 0x00 0x00 0x18000000 0x1c000000 0x00 0x1c000000 0x4000000>;

		g3d-pilot@14aa0000 {
			regulator-boot-on;
			regulator-always-on;
			regulator-max-microvolt = <0xa95f6>;
			regulator-min-microvolt = <0xa95f6>;
			regulator-name = "vdd_g3d_verified_gpio";
			enable-gpios = <0x7473 0x04 0x00>;
			samsung,pmic = <0x7472>;
			clock-names = "ref";
			clocks = <0x08>;
			#clock-cells = <0x00>;
			phandle = <0x7471>;
			reg = <0x14aa0000 0x1000>;
			compatible = "samsung,zerolte-g3d-pilot";
		};

		i2c@14e10000 {
			status = "okay";
			#size-cells = <0x00>;
			#address-cells = <0x01>;
			clock-frequency = <0x61a80>;
			clock-names = "hsi2c";
			clocks = <0x0d 0x0a>;
			interrupts = <0x00 0x1ce 0x04>;
			reg = <0x14e10000 0x1000>;
			compatible = "samsung,exynos7-hsi2c";

			touchscreen@49 {
				keyled-supply = <0x7752>;
				vdd-supply = <0xd032>;
				avdd-supply = <0xd031>;
				pinctrl-0 = <0xd033>;
				pinctrl-names = "default";
				interrupts = <0x06 0x08>;
				interrupt-parent = <0x24>;
				reg = <0x49>;
				compatible = "samsung,zerolte-fts";
			};
		};

		pcie@15660000 {
			pinctrl-0 = <0xd022 0xd023>;
			pinctrl-names = "default";
			reset-gpios = <0xd021 0x00 0x01>;
			enable-gpios = <0x29 0x06 0x00>;
			interrupt-map = <0x00 0x00 0x00 0x01 0x01 0x00 0xcd 0x04 0x00 0x00 0x00 0x02 0x01 0x00 0xcd 0x04 0x00 0x00 0x00 0x03 0x01 0x00 0xcd 0x04 0x00 0x00 0x00 0x04 0x01 0x00 0xcd 0x04>;
			interrupt-map-mask = <0x00 0x00 0x00 0x07>;
			ranges = <0x2000000 0x00 0x1c011000 0x1c011000 0x00 0x3fef000>;
			bus-range = <0x00 0x01>;
			#interrupt-cells = <0x01>;
			#size-cells = <0x02>;
			#address-cells = <0x03>;
			max-link-speed = <0x01>;
			num-lanes = <0x01>;
			interrupts = <0x00 0xcd 0x04>;
			clock-names = "bus\0ahb\0master\0slave\0dbi-gate\0pcs-gate\0async\0link\0ref24\0refgate\0tx\0rx";
			clocks = <0x1d 0x10 0x1d 0x11 0x1d 0x12 0x1d 0x13 0x1d 0x14 0x1d 0x15 0x1d 0x16 0x1d 0x17 0x1d 0x18 0x1d 0x19 0x1d 0x1a 0x1d 0x1b>;
			reg-names = "elbi\0phy\0block\0pmu\0dbi\0cmu\0pcs\0config";
			reg = <0x15660000 0x1000 0x15630000 0x1000 0x1005265c 0x04 0x105c071c 0x04 0x157b0000 0x1000 0x156e0f00 0x04 0x156f00e4 0x04 0x1c000000 0x1000>;
			status = "okay";
			device_type = "pci";
			compatible = "samsung,zerolte-pcie-wlan";
		};

		atlas-prepare@11800000 {
			cpu-supply = <0xd018>;
			clocks = <0xd017 0x04>;
			reg = <0x11800000 0x2000>;
			compatible = "samsung,zerolte-atlas-prepare";
		};

		clock-controller@11800000 {
			phandle = <0xd017>;
			#clock-cells = <0x01>;
			reg = <0x11800000 0x2000>;
			compatible = "samsung,zerolte-atlas-clock";
		};

		clock-controller@11900000 {
			phandle = <0xd014>;
			#clock-cells = <0x01>;
			reg = <0x11900000 0x2000>;
			compatible = "samsung,zerolte-apollo-clock";
		};

		chipid@10000000 {
			compatible = "samsung,exynos7-chipid\0samsung,exynos4210-chipid";
			reg = <0x10000000 0x100>;
		};

		interrupt-controller@11001000 {
			compatible = "arm,gic-400";
			#interrupt-cells = <0x03>;
			#address-cells = <0x00>;
			interrupt-controller;
			reg = <0x11001000 0x1000 0x11002000 0x2000 0x11004000 0x2000 0x11006000 0x2000>;
			phandle = <0x01>;
		};

		dma-controller@10e10000 {
			compatible = "arm,pl330\0arm,primecell";
			reg = <0x10e10000 0x1000>;
			interrupts = <0x00 0xe1 0x04>;
			clocks = <0x07 0x09>;
			clock-names = "apb_pclk";
			#dma-cells = <0x01>;
		};

		dma-controller@10eb0000 {
			compatible = "arm,pl330\0arm,primecell";
			reg = <0x10eb0000 0x1000>;
			interrupts = <0x00 0xe2 0x04>;
			clocks = <0x07 0x0a>;
			clock-names = "apb_pclk";
			#dma-cells = <0x01>;
		};

		clock-controller@10570000 {
			compatible = "samsung,exynos7-clock-topc";
			reg = <0x10570000 0x10000>;
			#clock-cells = <0x01>;
			phandle = <0x09>;
		};

		clock-controller@105d0000 {
			compatible = "samsung,exynos7-clock-top0";
			reg = <0x105d0000 0xb000>;
			#clock-cells = <0x01>;
			clocks = <0x08 0x09 0x02 0x09 0x03 0x09 0x04 0x09 0x05 0x09 0x09>;
			clock-names = "fin_pll\0dout_sclk_bus0_pll\0dout_sclk_bus1_pll\0dout_sclk_cc_pll\0dout_sclk_mfc_pll\0dout_sclk_aud_pll";
			phandle = <0x0a>;
		};

		clock-controller@105e0000 {
			compatible = "samsung,exynos7-clock-top1";
			reg = <0x105e0000 0xb000>;
			#clock-cells = <0x01>;
			clocks = <0x08 0x09 0x02 0x09 0x03 0x09 0x04 0x09 0x05>;
			clock-names = "fin_pll\0dout_sclk_bus0_pll\0dout_sclk_bus1_pll\0dout_sclk_cc_pll\0dout_sclk_mfc_pll";
			phandle = <0x0b>;
		};

		clock-controller@105b0000 {
			compatible = "samsung,exynos7-clock-ccore";
			reg = <0x105b0000 0xd00>;
			#clock-cells = <0x01>;
			clocks = <0x08 0x09 0x06>;
			clock-names = "fin_pll\0dout_aclk_ccore_133";
			phandle = <0x1b>;
		};

		clock-controller@13610000 {
			compatible = "samsung,exynos7-clock-peric0";
			reg = <0x13610000 0xd00>;
			#clock-cells = <0x01>;
			clocks = <0x08 0x0a 0x02 0x0a 0x03>;
			clock-names = "fin_pll\0dout_aclk_peric0_66\0sclk_uart0";
			phandle = <0x0c>;
		};

		clock-controller@14c80000 {
			compatible = "samsung,exynos7-clock-peric1";
			reg = <0x14c80000 0xd00>;
			#clock-cells = <0x01>;
			clocks = <0x08 0x0a 0x01 0x0a 0x04 0x0a 0x05 0x0a 0x06 0x0a 0x07 0x0a 0x08 0x0a 0x09 0x0a 0x0a 0x0a 0x0b 0x0a 0x0e 0x0a 0x0d 0x0a 0x0c>;
			clock-names = "fin_pll\0dout_aclk_peric1_66\0sclk_uart1\0sclk_uart2\0sclk_uart3\0sclk_spi0\0sclk_spi1\0sclk_spi2\0sclk_spi3\0sclk_spi4\0sclk_i2s1\0sclk_pcm1\0sclk_spdif";
			phandle = <0x0d>;
		};

		clock-controller@10040000 {
			compatible = "samsung,exynos7-clock-peris";
			reg = <0x10040000 0xd00>;
			#clock-cells = <0x01>;
			clocks = <0x08 0x09 0x01>;
			clock-names = "fin_pll\0dout_aclk_peris_66";
			phandle = <0x1c>;
		};

		clock-controller@10e90000 {
			compatible = "samsung,exynos7-clock-fsys0";
			reg = <0x10e90000 0xd00>;
			#clock-cells = <0x01>;
			clocks = <0x08 0x0b 0x02 0x0b 0x03>;
			clock-names = "fin_pll\0dout_aclk_fsys0_200\0dout_sclk_mmc2";
			phandle = <0x07>;
		};

		clock-controller@156e0000 {
			compatible = "samsung,exynos7-clock-fsys1";
			reg = <0x156e0000 0xd00>;
			#clock-cells = <0x01>;
			clocks = <0x08 0x0b 0x01 0x0b 0x05 0x0b 0x04 0x0b 0x0e 0x0b 0x10 0x0b 0x11>;
			clock-names = "fin_pll\0dout_aclk_fsys1_200\0dout_sclk_mmc0\0dout_sclk_mmc1\0dout_sclk_ufsunipro20\0dout_sclk_phy_fsys1\0dout_sclk_phy_fsys1_26m";
			phandle = <0x1d>;
		};

		serial@13630000 {
			compatible = "samsung,exynos7-uart\0samsung,exynos4210-uart";
			reg = <0x13630000 0x100>;
			interrupts = <0x00 0x1b8 0x04>;
			clocks = <0x0c 0x01 0x0c 0x02>;
			clock-names = "uart\0clk_uart_baud0";
			status = "disabled";
		};

		serial@14c20000 {
			compatible = "samsung,exynos7-uart\0samsung,exynos4210-uart";
			reg = <0x14c20000 0x100>;
			interrupts = <0x00 0x1c8 0x04>;
			clocks = <0x0d 0x01 0x0d 0x04>;
			clock-names = "uart\0clk_uart_baud0";
			status = "okay";
		};

		serial@14c30000 {
			compatible = "samsung,exynos7-uart\0samsung,exynos4210-uart";
			reg = <0x14c30000 0x100>;
			interrupts = <0x00 0x1c9 0x04>;
			clocks = <0x0d 0x02 0x0d 0x05>;
			clock-names = "uart\0clk_uart_baud0";
			status = "disabled";
		};

		serial@14c40000 {
			compatible = "samsung,exynos7-uart\0samsung,exynos4210-uart";
			reg = <0x14c40000 0x100>;
			interrupts = <0x00 0x1ca 0x04>;
			clocks = <0x0d 0x03 0x0d 0x06>;
			clock-names = "uart\0clk_uart_baud0";
			status = "disabled";
		};

		pinctrl@10580000 {
			compatible = "samsung,exynos7-pinctrl";
			reg = <0x10580000 0x1000>;

			gui1-touch-irq-pins {
				phandle = <0xd033>;
				samsung,pin-drv = <0x00>;
				samsung,pin-pud = <0x00>;
				samsung,pin-function = <0x0f>;
				samsung,pins = "gpa1-6";
			};

			muic-irq-pins {
				phandle = <0x25>;
				samsung,pin-drv = <0x00>;
				samsung,pin-pud = <0x00>;
				samsung,pin-function = <0x0f>;
				samsung,pins = "gpa1-4";
			};

			wakeup-interrupt-controller {
				compatible = "samsung,exynos7-wakeup-eint";
				interrupt-parent = <0x01>;
				interrupts = <0x00 0x10 0x04>;
			};

			gpa0-gpio-bank {
				phandle = <0x7751>;
				gpio-controller;
				#gpio-cells = <0x02>;
				interrupt-controller;
				interrupt-parent = <0x01>;
				#interrupt-cells = <0x02>;
				interrupts = <0x00 0x00 0x04 0x00 0x01 0x04 0x00 0x02 0x04 0x00 0x03 0x04 0x00 0x04 0x04 0x00 0x05 0x04 0x00 0x06 0x04 0x00 0x07 0x04>;
			};

			gpa1-gpio-bank {
				phandle = <0x24>;
				gpio-controller;
				#gpio-cells = <0x02>;
				interrupt-controller;
				interrupt-parent = <0x01>;
				#interrupt-cells = <0x02>;
				interrupts = <0x00 0x08 0x04 0x00 0x09 0x04 0x00 0x0a 0x04 0x00 0x0b 0x04 0x00 0x0c 0x04 0x00 0x0d 0x04 0x00 0x0e 0x04 0x00 0x0f 0x04>;
			};

			gpa2-gpio-bank {
				gpio-controller;
				#gpio-cells = <0x02>;
				interrupt-controller;
				#interrupt-cells = <0x02>;
				phandle = <0x2b>;
			};

			gpa3-gpio-bank {
				gpio-controller;
				#gpio-cells = <0x02>;
				interrupt-controller;
				#interrupt-cells = <0x02>;
			};

			bt1-host-pins {
				samsung,pins = "gpa2-1";
				samsung,pin-function = <0x0f>;
				samsung,pin-pud = <0x00>;
				phandle = <0x2c>;
