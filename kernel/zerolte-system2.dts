			#address-cells = <0x01>;
			#size-cells = <0x00>;
			reg = <0x15560000 0x2000>;
			clocks = <0x07 0x01 0x0b 0x06>;
			clock-names = "biu\0ciu";
			fifo-depth = <0x40>;
			status = "disabled";
		};

		adc@13620000 {
			phandle = <0x7420>;
			compatible = "samsung,exynos7420-adc";
			reg = <0x13620000 0x100>;
			interrupts = <0x00 0x1c0 0x04>;
			clocks = <0x0c 0x0c>;
			clock-names = "adc";
			#io-channel-cells = <0x01>;
			status = "okay";
		};

		pwm@136c0000 {
			compatible = "samsung,exynos7-pwm\0samsung,exynos4210-pwm";
			reg = <0x136c0000 0x100>;
			interrupts = <0x00 0x1c1 0x04 0x00 0x1c2 0x04 0x00 0x1c3 0x04 0x00 0x1c4 0x04 0x00 0x1c5 0x04>;
			samsung,pwm-outputs = <0x00 0x01 0x02 0x03>;
			#pwm-cells = <0x03>;
			clocks = <0x0c 0x0a>;
			clock-names = "timers";
		};

		tmu@10060000 {
			samsung,apollo-cmu = <0xd014>;
			compatible = "samsung,zerolte-tmu-observe";
			reg = <0x10060000 0x200 0x10064000 0x200 0x10068000 0x200 0x1006c000 0x200>;
			interrupts = <0x00 0x6c 0x04>;
			clocks = <0x1c 0x04 0x1c 0x05>;
			clock-names = "tmu_apbif\0tmu_sclk";
			#thermal-sensor-cells = <0x00>;
			phandle = <0x22>;
		};

		ufs@15570000 {
			compatible = "samsung,exynos7420-ufs";
			reg = <0x15570000 0x100 0x15570100 0x100 0x15571000 0x200 0x15572000 0x300>;
			reg-names = "hci\0vs_hci\0unipro\0ufsp";
			interrupts = <0x00 0xc8 0x04>;
			clocks = <0x1d 0x06 0x1d 0x07>;
			clock-names = "core_clk\0sclk_unipro_main";
			freq-table-hz = <0x00 0x00 0x00 0x00>;
			pinctrl-names = "default";
			pinctrl-0 = <0x1e 0x1f>;
			phys = <0x20>;
			phy-names = "ufs-phy";
			status = "okay";
		};

		ufs-phy@15571800 {
			compatible = "samsung,exynos7-ufs-phy";
			reg = <0x15571800 0x240>;
			reg-names = "phy-pma";
			samsung,pmu-syscon = <0x1a>;
			#phy-cells = <0x00>;
			clocks = <0x1d 0x0c 0x1d 0x08 0x1d 0x09 0x1d 0x0a>;
			clock-names = "ref_clk\0rx1_symbol_clk\0rx0_symbol_clk\0tx0_symbol_clk";
			phandle = <0x20>;
		};

		phy@15500000 {
			samsung,g925i-force-vbus-valid = <0x01>;
			status = "okay";
			compatible = "samsung,exynos7-usbdrd-phy";
			reg = <0x15500000 0x100>;
			clocks = <0x07 0x03 0x07 0x08 0x07 0x07 0x07 0x06 0x07 0x05>;
			clock-names = "phy\0ref\0phy_utmi\0phy_pipe\0itp";
			samsung,pmu-syscon = <0x1a>;
			#phy-cells = <0x01>;
			phandle = <0x21>;
		};

		usb@15400000 {
			status = "okay";
			compatible = "samsung,exynos7-dwusb3";
			clocks = <0x07 0x03 0x07 0x04 0x07 0x02>;
			clock-names = "usbdrd30\0usbdrd30_susp_clk\0usbdrd30_axius_clk";
			#address-cells = <0x01>;
			#size-cells = <0x01>;
			ranges = <0x00 0x15400000 0x10000>;

			usb@0 {
				status = "okay";
				maximum-speed = "high-speed";
				dr_mode = "peripheral";
				compatible = "snps,dwc3";
				reg = <0x00 0x10000>;
				interrupts = <0x00 0xdf 0x04>;
				phys = <0x21 0x00 0x21 0x01>;
				phy-names = "usb2-phy\0usb3-phy";
			};
		};

		syscon@11400000 {
			compatible = "samsung,exynos7420-lpass\0syscon";
			reg = <0x11400000 0x100>;
			phandle = <0x27>;
		};

		clock-controller@114c0000 {
			compatible = "samsung,exynos7-clock-aud";
			reg = <0x114c0000 0xd00>;
			#clock-cells = <0x01>;
			clocks = <0x08 0x09 0x0a>;
			clock-names = "fin_pll\0fout_aud_pll";
			phandle = <0x26>;
		};

		pinctrl@114b0000 {
			compatible = "samsung,exynos7-pinctrl";
			reg = <0x114b0000 0x1000>;
			interrupts = <0x00 0x5c 0x04>;
			clocks = <0x26 0x08>;
			clock-names = "pclk";

			gpz0-gpio-bank {
				gpio-controller;
				#gpio-cells = <0x02>;
				interrupt-controller;
				#interrupt-cells = <0x02>;
			};

			gpz1-gpio-bank {
				gpio-controller;
				#gpio-cells = <0x02>;
				interrupt-controller;
				#interrupt-cells = <0x02>;
			};

			bt1-uart-pins {
				samsung,pins = "gpz1-3\0gpz1-2\0gpz1-1\0gpz1-0";
				samsung,pin-function = <0x02>;
				samsung,pin-pud = <0x03>;
				phandle = <0x28>;
			};
		};

		serial@11460000 {
			compatible = "samsung,exynos7420-uart\0samsung,exynos4210-uart";
			samsung,lpass-syscon = <0x27>;
			reg = <0x11460000 0x100>;
			interrupts = <0x00 0x5b 0x04>;
			clocks = <0x26 0x07 0x26 0x06>;
			clock-names = "uart\0clk_uart_baud0";
			samsung,uart-fifosize = <0x100>;
			pinctrl-names = "default";
			pinctrl-0 = <0x28>;
			status = "okay";

			bluetooth {
				compatible = "brcm,bcm4358-bt";
				max-speed = <0x1c200>;
				shutdown-gpios = <0x29 0x01 0x00>;
				device-wakeup-gpios = <0x2a 0x04 0x00>;
				interrupt-parent = <0x2b>;
				interrupts = <0x01 0x01>;
				interrupt-names = "host-wakeup";
				pinctrl-names = "default";
				pinctrl-0 = <0x2c 0x2d 0x2e>;
			};
		};
	};

	thermal-zones {

		cluster0-thermal {
			polling-delay-passive = <0x00>;
			polling-delay = <0x00>;
			thermal-sensors = <0x22>;

			trips {

				cpu-alert-0 {
					temperature = <0x124f8>;
					hysteresis = <0x2710>;
					type = "passive";
				};

				cpu-alert-1 {
					temperature = <0x13880>;
					hysteresis = <0x2710>;
					type = "passive";
				};

				cpu-alert-2 {
					temperature = <0x14c08>;
					hysteresis = <0x2710>;
					type = "passive";
				};

				cpu-alert-3 {
					temperature = <0x15f90>;
					hysteresis = <0x2710>;
					type = "passive";
				};

				cpu-alert-4 {
					temperature = <0x17318>;
					hysteresis = <0x2710>;
					type = "passive";
				};

				cpu-alert-5 {
					temperature = <0x186a0>;
					hysteresis = <0x2710>;
					type = "passive";
				};

				cpu-alert-6 {
					temperature = <0x1adb0>;
					hysteresis = <0x2710>;
					type = "passive";
				};

				cpu-crit-0 {
					temperature = <0x1c138>;
					hysteresis = <0x00>;
					type = "critical";
				};
			};
		};
	};

	timer {
		samsung,zerolte-physical-counter = <0x01>;
		arm,cpu-registers-not-fw-configured;
		clock-frequency = <0x16e3600>;
		compatible = "arm,armv8-timer";
		interrupts = <0x01 0x0d 0xff08 0x01 0x0e 0xff08 0x01 0x0b 0xff08 0x01 0x0a 0xff08>;
	};

	chosen {
		samsung,s6-bootdiag-recovery = <0x01>;
		samsung,s6-bootdiag = <0x01>;
		#size-cells = <0x02>;
		#address-cells = <0x02>;
		stdout-path = "serial0:115200n8";
		bootargs = "earlycon=exynos4210,0x14c20000 console=ttySAC0,115200n8 console=tty0 clk_ignore_unused nokaslr maxcpus=8 rdinit=/init panic=0 fbcon=nodefer console=tty0 rdinit=/init printk.time=1 fbcon=nodefer regulator_ignore_unused pcie_aspm=off quiet vt.global_cursor_default=0 loglevel=3";

		framebuffer@e2a00000 {
			memory-region = <0x23>;
			status = "okay";
			format = "a8r8g8b8";
			stride = <0x1680>;
			height = <0xa00>;
			width = <0x5a0>;
			reg = <0x00 0xe2a00000 0x00 0xe10000>;
			compatible = "simple-framebuffer";
		};
	};

	memory@40000000 {
		device_type = "memory";
		reg = <0x00 0x40000000 0x00 0xbe800000>;
	};

	reserved-memory {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;

		mfc-nfw@e2600000 {
			reg = <0x00 0xe2600000 0x00 0x110000>;
			no-map;
		};

		mfc-fw@e2800000 {
			reg = <0x00 0xe2800000 0x00 0x200000>;
			no-map;
		};

		video@e2a00000 {
			reg = <0x00 0xe2a00000 0x00 0xe400000>;
			no-map;
		};

		video-ext@f0e00000 {
			reg = <0x00 0xf0e00000 0x00 0x600000>;
			no-map;
		};

		iram-vector@f2a00000 {
			reg = <0x00 0xf2a00000 0x00 0x200000>;
			no-map;
		};

		sss-debug@f2c00000 {
			reg = <0x00 0xf2c00000 0x00 0x100000>;
			no-map;
		};

		framebuffer@e2a00000 {
			phandle = <0x23>;
			reg = <0x00 0xe2a00000 0x00 0xe10000>;
			no-map;
		};
	};
};
