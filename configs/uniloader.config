#
# Automatically generated make config: don't edit
# uniLoader Configuration
#

#
# Architecture
#
CONFIG_POSITION_INDEPENDENT=y
CONFIG_LINUX_KRNL_HEADER_IMG=y

#
# Building options
#
CONFIG_CROSS_COMPILE=""
CONFIG_LOGLEVEL=0
# CONFIG_COMPRESS_GZIP is not set
# CONFIG_COMPRESS_LZ4 is not set
CONFIG_EMBED_LINUX=y
CONFIG_KERNEL_PATH="blob/Image"
CONFIG_DT_PATH="blob/dtb"
CONFIG_RAMDISK_PATH="blob/ramdisk"
# CONFIG_RAMDISK_NO_COPY is not set

#
# Drivers
#
# CONFIG_EXYNOS_ACPM is not set
# CONFIG_EXYNOS_SPEEDY is not set
# CONFIG_TIMER is not set

#
# Libraries
#
